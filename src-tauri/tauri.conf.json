{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "todoary",
  "version": "0.7.26",
  "identifier": "app.vibe-diary",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "node scripts/build-dist.mjs",
    "beforeBuildCommand": "node scripts/build-dist.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "url": "todoary.html",
        "title": "todoary",
        "width": 440,
        "height": 1000,
        "minWidth": 420,
        "minHeight": 360,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "macOS": {
      "infoPlist": "Info.plist"
    },
    "windows": {
      "nsis": {
        "installerHooks": "installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/beyejin/workingtable/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE5QzBFRUY4NjFCOUY5RjEKUldUeCtibGgrTzdBR1VncktPelQ4akFVQ25kaTBiaStDRVFwU25oVksxYU1YTEVObjkzVFBMc3QK"
    }
  }
}
