{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vibe-diary-yejin",
  "version": "0.4.16",
  "identifier": "app.vibe-diary-yejin",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "node scripts/build-dist.mjs",
    "beforeBuildCommand": "node scripts/build-dist.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "url": "바이브 다이어리 - 사이드 도크 v2.html",
        "title": "vibe diary",
        "width": 420,
        "height": 760,
        "visible": true,
        "minWidth": 380,
        "minHeight": 360,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/beyejin/workingtable/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVBQTg5RTk5OTc2MUM3NTMKUldSVHgyR1htWjZvNnArWXVqS01mdzdsTkdjU2xzR1F3Znc3MG1VakxqU2dReC9sMTdqclo1bVMK"
    }
  }
}
